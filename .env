# Configuración del Servidor
PORT=3000

# Configuración Transbank POS
# El puerto serial donde está conectado el equipo (ej: COM4 en Windows, /dev/ttyUSB0 en Linux)
TRANSBANK_PORT=COM10

# Configuración Base de Datos Remota (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=testdb
DB_USER=root
DB_PASSWORD=123456

# Configuración de Impresora Térmica
PRINTER_PORT=COM4
